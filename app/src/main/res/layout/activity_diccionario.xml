<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- MARCA DE AGUA -->
    <ImageView
        android:layout_width="460dp"
        android:layout_height="230dp"
        android:layout_gravity="center"
        android:alpha="0.025"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_guarani" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===================================== -->
            <!-- ENCABEZADO -->
            <!-- ===================================== -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/verde_oscuro">

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="← Volver"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="300dp"
                    android:layout_height="155dp"
                    android:layout_gravity="center"
                    android:contentDescription="Guaraní Para Todos"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_guarani" />

            </FrameLayout>


            <!-- ===================================== -->
            <!-- CONTENIDO -->
            <!-- ===================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingTop="28dp"
                android:paddingRight="24dp"
                android:paddingBottom="38dp">

                <!-- TÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Diccionario"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="22dp"
                    android:text="Buscá una palabra en guaraní o español"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />


                <!-- ===================================== -->
                <!-- BUSCADOR -->
                <!-- ===================================== -->

                <EditText
                    android:id="@+id/edtBuscarPalabra"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_busqueda_diccionario"
                    android:hint="Escribí una palabra"
                    android:inputType="text"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="@color/texto_secundario"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_accion_verde"
                    android:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="Buscar palabra"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- MENSAJES -->
                <TextView
                    android:id="@+id/txtMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp" />


                <!-- ===================================== -->
                <!-- RESULTADO -->
                <!-- ===================================== -->

                <LinearLayout
                    android:id="@+id/contenedorResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone">


                    <!-- PALABRA -->
                    <TextView
                        android:id="@+id/txtPalabraBuscada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="30sp"
                        android:textStyle="bold" />


                    <!-- TIPO DE SIGNIFICADO -->
                    <TextView
                        android:id="@+id/txtTipoSignificado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <!-- SIGNIFICADO -->
                    <TextView
                        android:id="@+id/txtSignificado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="21sp" />


                    <!-- AUDIO -->
                    <Button
                        android:id="@+id/btnReproducirAudio"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_accion_verde"
                        android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_volume"
                        android:drawablePadding="10dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:stateListAnimator="@null"
                        android:text="Escuchar pronunciación"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <!-- DIVISOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="25dp"
                        android:layout_marginBottom="22dp"
                        android:background="@color/borde_tarjeta" />


                    <!-- ===================================== -->
                    <!-- EJEMPLOS -->
                    <!-- ===================================== -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ejemplos"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEjemplos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="16sp" />


                    <!-- DIVISOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="22dp"
                        android:background="@color/borde_tarjeta" />


                    <!-- ===================================== -->
                    <!-- CONJUGACIÓN -->
                    <!-- ===================================== -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Conjugación"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/txtSinConjugacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Esta palabra no posee conjugación."
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp"
                        android:visibility="gone" />


                    <HorizontalScrollView
                        android:id="@+id/scrollConjugacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fillViewport="true"
                        android:scrollbars="horizontal"
                        android:visibility="gone">

                        <TableLayout
                            android:id="@+id/tablaConjugacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*" />

                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>