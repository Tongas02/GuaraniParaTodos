<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <ImageView
        android:layout_width="460dp"
        android:layout_height="230dp"
        android:layout_gravity="center"
        android:alpha="0.025"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_guarani" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/verde_oscuro">

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="← Volver"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="300dp"
                    android:layout_height="155dp"
                    android:layout_gravity="center"
                    android:contentDescription="Guaraní Para Todos"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_guarani" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestión de Actividades"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="22dp"
                    android:text="Creá ejercicios para cada nivel de aprendizaje"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Configuración"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Seleccioná el nivel y el tipo de ejercicio"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Nivel"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_busqueda_diccionario">

                        <Spinner
                            android:id="@+id/spinnerNivel"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:text="Tipo de actividad"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_busqueda_diccionario">

                        <Spinner
                            android:id="@+id/spinnerTipo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información general"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Identificá la actividad antes de crear el ejercicio"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Título de la actividad"
                        android:inputType="textCapSentences"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/edtDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:gravity="top|start"
                        android:hint="Descripción o indicación"
                        android:inputType="textCapSentences|textMultiLine"
                        android:padding="17dp"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contenedorCompletar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Actividad de completar"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Utilizá espacios para indicar dónde debe completar el estudiante"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEnunciadoCompletar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Ej.: Che ___ ógape"
                        android:inputType="textCapSentences"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/edtRespuestaCompletar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Respuesta correcta"
                        android:inputType="text"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contenedorRellenar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Actividad de rellenar"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="El estudiante deberá escribir la respuesta"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEnunciadoRellenar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Ej.: Escriba en guaraní: Casa"
                        android:inputType="textCapSentences"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/edtRespuestaRellenar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Respuesta correcta"
                        android:inputType="text"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contenedorSeleccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selección múltiple"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ingresá las opciones y marcá la respuesta correcta"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEnunciadoSeleccion"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Pregunta"
                        android:inputType="textCapSentences"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/edtOpcion1"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Opción 1"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario" />

                    <CheckBox
                        android:id="@+id/chkOpcion1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde_principal"
                        android:text="Respuesta correcta"
                        android:textColor="@color/texto_oscuro" />

                    <EditText
                        android:id="@+id/edtOpcion2"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Opción 2"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario" />

                    <CheckBox
                        android:id="@+id/chkOpcion2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde_principal"
                        android:text="Respuesta correcta"
                        android:textColor="@color/texto_oscuro" />

                    <EditText
                        android:id="@+id/edtOpcion3"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Opción 3"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario" />

                    <CheckBox
                        android:id="@+id/chkOpcion3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde_principal"
                        android:text="Respuesta correcta"
                        android:textColor="@color/texto_oscuro" />

                    <EditText
                        android:id="@+id/edtOpcion4"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Opción 4 (opcional)"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario" />

                    <CheckBox
                        android:id="@+id/chkOpcion4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde_principal"
                        android:text="Respuesta correcta"
                        android:textColor="@color/texto_oscuro" />

                    <EditText
                        android:id="@+id/edtOpcion5"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Opción 5 (opcional)"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario" />

                    <CheckBox
                        android:id="@+id/chkOpcion5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde_principal"
                        android:text="Respuesta correcta"
                        android:textColor="@color/texto_oscuro" />

                    <EditText
                        android:id="@+id/edtOpcion6"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Opción 6 (opcional)"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario" />

                    <CheckBox
                        android:id="@+id/chkOpcion6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde_principal"
                        android:text="Respuesta correcta"
                        android:textColor="@color/texto_oscuro" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnGuardarActividad"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_accion_verde"
                    android:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_save"
                    android:drawablePadding="10dp"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="Guardar actividad"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Actividades registradas"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Listado de actividades creadas"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/contenedorActividades"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/txtSinActividades"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="No hay actividades registradas."
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>