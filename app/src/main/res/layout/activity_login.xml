<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- LOGO DIFUMINADO DE FONDO -->
    <ImageView
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:alpha="0.045"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_launcher" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="45dp"
            android:paddingRight="28dp"
            android:paddingBottom="35dp">

            <!-- LOGO PRINCIPAL -->
            <ImageView
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:contentDescription="Logo Guaraní Para Todos"
                android:elevation="6dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_launcher" />

            <!-- NOMBRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Guaraní Para Todos"
                android:textColor="@color/verde_oscuro"
                android:textSize="27sp"
                android:textStyle="bold" />

            <!-- FRASE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Aprendé. Practicá. Avanzá."
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <!-- TARJETA LOGIN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_card_login"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="22dp"
                    android:text="Ingresá a tu cuenta para continuar"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <!-- CORREO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Correo electrónico"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="#9AA7A1"
                    android:textSize="16sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:layout_marginBottom="7dp"
                    android:text="Contraseña"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ingresá tu contraseña"
                    android:inputType="textPassword"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="#9AA7A1"
                    android:textSize="16sp" />

                <!-- INICIAR SESIÓN -->
                <Button
                    android:id="@+id/btnIniciarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_button_primary"
                    android:elevation="3dp"
                    android:text="Iniciar sesión"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- CREAR CUENTA -->
                <Button
                    android:id="@+id/btnCrearCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:text="¿No tenés cuenta? Crear cuenta"
                    android:textAllCaps="false"
                    android:textColor="@color/verde_principal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TEXTO INFERIOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:text="Aprendiendo nuestra lengua, fortalecemos nuestra cultura."
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>