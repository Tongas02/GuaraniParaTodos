<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <ImageView
        android:layout_width="460dp"
        android:layout_height="230dp"
        android:layout_gravity="center"
        android:alpha="0.025"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_guarani" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/verde_oscuro">

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="← Volver"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="270dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:contentDescription="Guaraní Para Todos"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_guarani" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Actividades por Niveles"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Avanzá paso a paso en tu aprendizaje"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tu recorrido"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Completá las actividades de cada nivel. Necesitás alcanzar al menos el 70 % para desbloquear el siguiente."
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="Seleccioná un nivel"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBasico"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:backgroundTint="@null"
                    android:elevation="3dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="1   Nivel Básico"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIntermedio"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:backgroundTint="@null"
                    android:elevation="3dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="2   Nivel Intermedio"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAvanzado"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:backgroundTint="@null"
                    android:elevation="3dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="3   Nivel Avanzado"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="Los niveles se habilitan según tu progreso."
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>