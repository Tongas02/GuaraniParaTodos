<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <ImageView
        android:layout_width="460dp"
        android:layout_height="230dp"
        android:layout_gravity="center"
        android:alpha="0.025"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_guarani" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/verde_oscuro">

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="← Volver"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="270dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:contentDescription="Guaraní Para Todos"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_guarani" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mi Perfil"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Administrá tus datos y preferencias"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información personal"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Datos principales de tu cuenta"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Nombre"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:hint="Nombre"
                        android:inputType="textPersonName"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Correo electrónico"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:gravity="center_vertical"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:text="correo@ejemplo.com"
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Tipo de usuario"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTipoUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario"
                        android:gravity="center_vertical"
                        android:paddingStart="17dp"
                        android:paddingEnd="17dp"
                        android:text="ESTUDIANTE"
                        android:textColor="@color/verde_principal"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_menu_profesional"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Apariencia"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Elegí cómo querés visualizar la aplicación"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Tema de la aplicación"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_busqueda_diccionario">

                        <Spinner
                            android:id="@+id/spinnerTema"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="El cambio de tema se aplicará a tu cuenta."
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnGuardarCambios"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_accion_verde"
                    android:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_save"
                    android:drawablePadding="10dp"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="Guardar cambios"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>