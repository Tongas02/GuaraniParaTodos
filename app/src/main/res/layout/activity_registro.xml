<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- LOGO DIFUMINADO DE FONDO -->
    <ImageView
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:alpha="0.045"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_launcher" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="32dp"
            android:paddingRight="28dp"
            android:paddingBottom="35dp">

            <!-- LOGO -->
            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:contentDescription="Logo Guaraní Para Todos"
                android:elevation="5dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_launcher" />

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Crear cuenta"
                android:textColor="@color/verde_oscuro"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Empezá tu aprendizaje del idioma guaraní"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- TARJETA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_card_login"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- NOMBRE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="Nombre y apellido"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNombre"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ej: Gastón Petry"
                    android:inputType="textPersonName"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="#9AA7A1"
                    android:textSize="16sp" />

                <!-- CORREO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="7dp"
                    android:text="Correo electrónico"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="#9AA7A1"
                    android:textSize="16sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="7dp"
                    android:text="Contraseña"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ingresá una contraseña"
                    android:inputType="textPassword"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="#9AA7A1"
                    android:textSize="16sp" />

                <!-- CONFIRMAR CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="7dp"
                    android:text="Confirmar contraseña"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input"
                    android:hint="Repetí tu contraseña"
                    android:inputType="textPassword"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:singleLine="true"
                    android:textColor="@color/texto_oscuro"
                    android:textColorHint="#9AA7A1"
                    android:textSize="16sp" />

                <!-- REGISTRAR -->
                <Button
                    android:id="@+id/btnRegistrar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_button_primary"
                    android:elevation="3dp"
                    android:text="Crear cuenta"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- VOLVER -->
                <Button
                    android:id="@+id/btnVolverLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:text="← Volver al inicio de sesión"
                    android:textAllCaps="false"
                    android:textColor="@color/verde_principal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TEXTO INFERIOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Ñañangareko ñande ñe'ẽre."
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>